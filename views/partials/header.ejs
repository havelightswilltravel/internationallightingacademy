<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · International Lighting Academy</title>
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/static/js/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/"><span class="bulb" aria-hidden="true">💡</span> International Lighting Academy</a>
  <% if (user) { %>
  <button class="menu-toggle" type="button" aria-label="Menu" data-toggle="nav">☰</button>
  <nav id="nav">
    <a href="/" class="<%= path === '/' ? 'on' : '' %>">Dashboard</a>
    <a href="/levels" class="<%= path.startsWith('/levels') || path.startsWith('/courses') || path.startsWith('/lessons') ? 'on' : '' %>">Program</a>
    <a href="/library" class="<%= path.startsWith('/library') ? 'on' : '' %>">Library</a>
    <% if (user.role === 'technician') { %>
      <a href="/hours" class="<%= path.startsWith('/hours') ? 'on' : '' %>">My Hours</a>
      <a href="/transcript" class="<%= path.startsWith('/transcript') ? 'on' : '' %>">Transcript</a>
    <% } else { %>
      <a href="/team" class="<%= path.startsWith('/team') ? 'on' : '' %>">Team</a>
      <a href="/approvals" class="<%= path.startsWith('/approvals') ? 'on' : '' %>">Approvals</a>
    <% } %>
    <% if (user.role === 'admin' || user.role === 'owner') { %>
      <a href="/admin/users" class="<%= path.startsWith('/admin') ? 'on' : '' %>">Admin</a>
    <% } %>
    <% if (user.role === 'owner') { %>
      <a href="/platform/orgs" class="<%= path.startsWith('/platform') ? 'on' : '' %>">Platform</a>
    <% } %>
    <span class="who"><a href="/account"><%= user.name %></a><% if (typeof org !== 'undefined' && org) { %> · <%= org.name %><% } %></span>
    <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link">Sign out</button></form>
  </nav>
  <% } %>
</header>
<main class="container">
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.text %></div><% } %>
