<%- include('partials/header') %>
<h1>Troubleshooting library</h1>
<form method="get" class="search">
  <input type="search" name="q" value="<%= q %>" placeholder="Search guides — e.g. flicker, photocell, ballast hum">
  <select name="category"><option value="">All categories</option><% categories.forEach(function (c) { %><option value="<%= c.category %>" <%= cat === c.category ? 'selected' : '' %>><%= c.category %> (<%= c.n %>)</option><% }) %></select>
  <button class="btn">Search</button>
</form>
<% if (!docs.length) { %><p class="muted">No guides found.</p><% } %>
<div class="grid cards">
  <% docs.forEach(function (d) { %>
  <a class="card doc" href="/library/<%= d.id %>">
    <span class="eyebrow"><%= d.category %><%= d.org_id ? ' · ' + d.org_name : '' %></span>
    <strong><%= d.title %></strong>
    <% if (d.tags) { %><span class="small muted"><%= d.tags %></span><% } %>
  </a>
  <% }) %>
</div>
<%- include('partials/footer') %>
