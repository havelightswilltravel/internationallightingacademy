<%- include('partials/header') %>
<h1>My Skills Matrix</h1>
<p class="muted">Rate yourself honestly on every field system, then write out the troubleshooting steps <strong>in the correct order</strong> and list <strong>all the components</strong> of the system. Your evaluator reviews your answers and confirms your rating.</p>
<div class="scale-legend">
  <% Object.keys(scale).forEach(function (k) { %><span class="lvl lvl-<%= k %>"><b><%= k %></b> <%= scale[k] %></span><% }) %>
</div>
<% areas.forEach(function (a) { %>
<details class="card area" id="<%= a.code %>" <%= open === a.code ? 'open' : '' %>>
  <summary>
    <strong><%= a.title %></strong>
    <span class="ratings">
      <span class="lvl lvl-<%= a.self_rating || 0 %>" title="Your rating">Me: <%= a.self_rating || '—' %></span>
      <span class="lvl lvl-<%= a.eval_rating || 0 %>" title="Confirmed by evaluator">Confirmed: <%= a.eval_rating || '—' %></span>
    </span>
  </summary>
  <p class="small muted">Study: <% a.courses.forEach(function (c, i) { %><%= i ? ' · ' : '' %><a href="/courses/<%= c.code %>"><%= c.code %> <%= c.title %></a><% }) %>
    <% if (a.guide_id) { %> · <a href="/library/<%= a.guide_id %>">Field procedure</a><% } %></p>
  <% if (a.eval_notes) { %><div class="flash info small"><strong>Evaluator (<%= a.evaluator_name %>, <%= fmtDate(a.eval_updated_at) %>):</strong> <%= a.eval_notes %></div><% } %>
  <form method="post" action="/skills-matrix/<%= a.code %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <fieldset class="rate">
      <legend>My rating</legend>
      <% Object.keys(scale).forEach(function (k) { %>
      <label class="choice inline-choice"><input type="radio" name="self_rating" value="<%= k %>" <%= String(a.self_rating) === k ? 'checked' : '' %>> <span><b><%= k %></b> <%= scale[k] %></span></label>
      <% }) %>
    </fieldset>
    <label>Troubleshooting steps, in order <textarea name="steps_text" rows="5" placeholder="1. …&#10;2. …"><%= a.steps_text || '' %></textarea></label>
    <label>All the components of this system <textarea name="components_text" rows="2"><%= a.components_text || '' %></textarea></label>
    <button class="btn primary small">Save</button>
  </form>
</details>
<% }) %>
<% if (!areas.length) { %><p class="muted">The Skills Matrix has not been set up yet.</p><% } %>
<%- include('partials/footer') %>
